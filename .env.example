# Google AI Studio (Gemini API) 키
# https://aistudio.google.com 에서 발급
GOOGLE_API_KEY=

# 실제 키가 있어도 강제로 mock 응답만 쓰고 싶으면 true
MOCK_MODE=false

# 사용할 모델 (Google이 모델명을 바꾸는 경우가 있으니 최신 모델명은
# https://ai.google.dev 문서에서 직접 확인 후 필요시 교체하세요)
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001
GEMINI_VIDEO_MODEL=veo-3.0-generate-001

# 서버 포트
PORT=3000
