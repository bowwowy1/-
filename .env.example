# ===== Flask =====
FLASK_SECRET_KEY=change-me-please
FLASK_DEBUG=True
PORT=5000

# ===== 1) Gemini (기획/대본/프롬프트 설계) =====
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ===== 2) Typecast (TTS, 한국어 음성 합성) =====
TYPECAST_API_KEY=your_typecast_api_key
TYPECAST_API_URL=https://typecast.ai/api/speak
TYPECAST_ACTOR_ID=your_typecast_actor_id
TYPECAST_MODEL=ssfm-v21

# ===== 2) Flux (T2I, 이미지 생성 - bfl.ai 기준 예시) =====
FLUX_API_KEY=your_flux_api_key
FLUX_API_URL=https://api.bfl.ai/v1/flux-pro-1.1

# ===== 2) Kling (I2V, 영상 생성) =====
KLING_ACCESS_KEY=your_kling_access_key
KLING_SECRET_KEY=your_kling_secret_key
KLING_API_BASE=https://api.klingai.com

# ===== 3) OpenAI Whisper (STT, 자막용 타임스탬프) =====
OPENAI_API_KEY=your_openai_api_key
WHISPER_MODEL=whisper-1

# ===== 4) MoviePy 합성 리소스 =====
FONT_PATH=./fonts/NanumGothicBold.ttf
BGM_PATH=./assets/bgm/bgm.mp3
SFX_WHOOSH_PATH=./assets/sfx/whoosh.mp3
SFX_IMPACT_PATH=./assets/sfx/impact.mp3

# ===== 출력 =====
OUTPUT_DIR=./output
